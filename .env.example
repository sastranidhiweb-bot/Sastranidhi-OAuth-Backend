# ============================================================
# Sastranidhi OAuth Server — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it is gitignored).
# ============================================================

# --- App ---
NODE_ENV=development
PORT=4000
ISSUER=http://localhost:4000
# Comma-separated list of origins allowed to call this server (child apps + portal)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
# The portal (React app) that hosts the login/signup pages
FRONTEND_BASE_URL=http://localhost:5173

# --- MongoDB ---
# The database name is the path after the host, e.g. .../sastranidhi-outh?...
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# MONGODB_POOL_MAX=10

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Sessions (SSO session, backed by Redis) ---
SESSION_SECRET=<long random string>
SESSION_COOKIE_NAME=sastranidhi.sid
SESSION_COOKIE_DOMAIN=
SESSION_MAX_AGE_MS=1800000

# --- JWT (RS256 — see keys/ and scripts/generate-keys.js) ---
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_KEY_ID=sastranidhi-key-1
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Security ---
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
# Requests allowed per IP address per window (all endpoints / login+token endpoints)
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=1000

# --- Email ---
# 'console' logs verification codes / reset links instead of sending them.
# 'smtp' sends real email using the SMTP_* settings.
EMAIL_TRANSPORT=console
EMAIL_FROM="Sastranidhi <no-reply@sastranidhi.org>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Social login (leave *_CLIENT_ID empty to disable that provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:4000/auth/microsoft/callback
MICROSOFT_TENANT=common

# --- Edmingle LMS single sign-on ---
EDMINGLE_SSO_SECRET=
EDMINGLE_LMS_URL=https://<your-academy>.edmingle.com

# --- MFA ---
MFA_ISSUER_NAME=Sastranidhi
MFA_CHALLENGE_EXPIRES_IN_SECONDS=300

# --- Logging ---
LOG_LEVEL=info
